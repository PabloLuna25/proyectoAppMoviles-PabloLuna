<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".AddReminderActivity"
    android:id="@+id/addReminder"
    android:background="@color/background">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar_addReminder"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/toolbar_bg"
        android:paddingTop="20dp"
        >

        <TextView
            android:id="@+id/lbTitleAddTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Task"
            android:textSize="24sp"
            android:textColor="#9fb8c9"
            android:fontFamily="@font/inter_medium"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_marginBottom="20dp"

            />

    </androidx.appcompat.widget.Toolbar>

    <TextView
        android:id="@+id/lbTaskTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/toolbar_addReminder"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="15dp"
        android:fontFamily="@font/inter"
        android:textColor="#9fb8c9"
        android:textSize="15sp"
        android:text="Titulo del reminder jasd"
        />

    <EditText
        android:id="@+id/txtTitle"
        android:layout_width="370dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbTaskTitle"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/input_field_login_signup"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/white"
        android:maxLines="1"
        android:inputType="text|textNoSuggestions"
        android:scrollHorizontally="true"
        android:ellipsize="none"
        android:imeOptions="actionDone"
        android:gravity="center_vertical|start"

        />

    <TextView
        android:id="@+id/lbDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="15dp"
        android:fontFamily="@font/inter"
        android:textColor="#9fb8c9"
        android:textSize="15sp"
        android:text="Descripción"
        />

    <EditText
        android:id="@+id/txtDescription"
        android:layout_width="370dp"
        android:layout_height="80dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbDescription"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/input_field_login_signup"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:inputType="textMultiLine"
        android:gravity="start|top"
        android:maxLines="3"
        android:textColor="@color/white"
        />

    <CalendarView
        android:id="@+id/calendarView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusedMonthDateColor="@color/primary_1"
        android:selectedWeekBackgroundColor="@color/primary_1"
        android:background="@drawable/background_calendar"
        android:showWeekNumber="false"
        android:unfocusedMonthDateColor="#00FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/txtDescription"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="20dp"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        />

    <TextView
        android:id="@+id/lbTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/calendarView"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp"
        android:layout_marginStart="35dp"
        android:fontFamily="@font/inter"
        android:textColor="#9fb8c9"
        android:textSize="15sp"
        android:text="Time"
        />

    <EditText
        android:id="@+id/txtHour"
        android:layout_width="70dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lbTime"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/input_field_login_signup"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/white"
        android:maxLines="1"
        android:inputType="text|textNoSuggestions"
        android:scrollHorizontally="true"
        android:ellipsize="none"
        android:imeOptions="actionDone"
        android:gravity="center_vertical|start"

        />

    <TextView
        android:id="@+id/lbSperator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/lbTime"
        app:layout_constraintStart_toEndOf="@id/txtHour"
        android:layout_marginTop="10dp"
        android:layout_marginStart="5dp"
        android:fontFamily="@font/inter"
        android:textColor="#9fb8c9"
        android:textSize="25sp"
        android:text=":"
        />

    <EditText
        android:id="@+id/txtMinute"
        android:layout_width="70dp"
        android:layout_height="40dp"
        app:layout_constraintStart_toEndOf="@id/txtHour"
        app:layout_constraintTop_toBottomOf="@id/lbTime"
        android:layout_marginTop="10dp"
        android:layout_marginStart="15dp"
        android:background="@drawable/input_field_login_signup"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/white"
        android:maxLines="1"
        android:inputType="text|textNoSuggestions"
        android:scrollHorizontally="true"
        android:ellipsize="none"
        android:imeOptions="actionDone"
        android:gravity="center_vertical|start"
        />


    <Button
        android:id="@+id/btnAddImage"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/btn_primary_color_1"
        app:backgroundTint="@null"
        android:textAlignment="textEnd"
        android:text="Add image"
        android:paddingEnd="20dp"
        android:paddingStart="20dp"
        android:fontFamily="@font/inter_medium"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/calendarView"
        />

    <ImageView
        android:id="@+id/imgPreview"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:visibility="gone"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@id/btnAddImage"
        app:layout_constraintTop_toBottomOf="@id/btnAddImage"
        android:layout_marginTop="15dp"
        />

    <Button
        android:layout_width="170dp"
        android:layout_height="50dp"
        android:id="@+id/btnCancelReminder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/btn_background_text_color"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:text="Cancel"
        android:fontFamily="@font/inter_medium"
        android:textStyle="bold"
        android:textColor="@color/background_text_contrast"
        android:textSize="18sp"
        />

    <Button
        android:id="@+id/btnSaveReminder"
        android:layout_width="170dp"
        android:layout_height="50dp"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="20dp"
        android:background="@drawable/btn_primary_color_1"
        app:backgroundTint="@null"
        android:textAlignment="center"
        android:text="Save"
        android:fontFamily="@font/inter_medium"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />



</androidx.constraintlayout.widget.ConstraintLayout>